# Melos
.melos_tool/

# Melos-generated, regenerated by `melos bootstrap` on every clone/CI
pubspec_overrides.yaml

# Dependencies
pubspec.lock

# Generated files
*.g.dart
*.freezed.dart
# Exception: the vendored/patched video_player_avfoundation is a static copy that
# is never regenerated in CI, so its Pigeon-generated Dart must be tracked or the
# macOS release build fails ("messages.g.dart: No such file or directory").
!packages/video_player_avfoundation/lib/src/messages.g.dart

# Exception: baked licensing constants (public key + release date) are
# generated at release time but must be committed so debug/dev builds have
# them present. See packages/screen_recorder/lib/licensing/*.g.dart.
!packages/screen_recorder/lib/licensing/entitlement_public_key.g.dart
!packages/screen_recorder/lib/licensing/build_release_date.g.dart

# Coverage
coverage/
.test_coverage/

# Xcode
DerivedData/

# Local-only debug probe wiring (see packages/screen_recorder/lib/debug/README.md)
packages/screen_recorder/lib/debug/agent_wires_probe_binding.dart
packages/screen_recorder/lib/main_dev.dart

# Superpowers brainstorm session artifacts (mockups, server state)
.superpowers/

# Local MCP server config (has absolute paths and targets the gitignored dev entry point)
.mcp.json

# Node backend (server/)
server/node_modules/
server/dist/
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# Local PostHog build-time defines (contain the project key; injected in CI).
# The .example.json template is committed; real files are not.
packages/screen_recorder/dart_defines/posthog.json
packages/screen_recorder/dart_defines/posthog.local.json
packages/screen_recorder/dart_defines/*.local.json
