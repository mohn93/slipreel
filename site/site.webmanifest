{
  "name": "Slipreel",
  "short_name": "Slipreel",
  "description": "A macOS screen recorder that auto-zooms, smooths your cursor, frames your app, and captions it — the moment you stop recording.",
  "start_url": "/",
  "display": "browser",
  "background_color": "#08080C",
  "theme_color": "#08080C",
  "icons": [
    { "src": "/favicon.svg", "type": "image/svg+xml", "sizes": "any", "purpose": "any" },
    { "src": "/favicon.png", "type": "image/png", "sizes": "48x48" },
    { "src": "/apple-touch-icon.png", "type": "image/png", "sizes": "180x180" }
  ]
}
