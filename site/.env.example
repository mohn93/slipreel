# Site deploy config. Copy to site/.env (gitignored) and fill in.
#
# PostHog public project key (Project Settings -> API keys -> "Project API
# Key", starts with phc_). It is write-only and safe to ship in client code;
# it lives here only so scripts/deploy-site.sh can inject it into the deployed
# assets/js/ph-config.js instead of it being committed.
SITE_POSTHOG_KEY=phc_xxx
